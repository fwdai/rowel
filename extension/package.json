{
  "name": "rowel-browser-extension",
  "version": "0.1.1",
  "description": "Rowel browser extension, a fork of KeePassXC-Browser",
  "keepassxcBrowserVersion": "1.10.4",
  "main": "rowel-build.js",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "globals": "^17.13.0"
  },
  "dependencies": {
    "@npmcli/fs": "^6.0.0"
  },
  "scripts": {
    "build": "node rowel-build.js",
    "build:safari": "node safari/build.mjs",
    "debug:chromium": "cp dist/manifest_chromium.json rowel/manifest.json",
    "debug:firefox": "cp dist/manifest_firefox.json rowel/manifest.json",
    "lint": "npx eslint --no-warn-ignored rowel/**/*.js safari/*.js",
    "tests": "npx playwright test",
    "test:safari": "node --test safari/safari-native.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fwdai/rowel.git",
    "directory": "extension"
  },
  "author": "Rowel, based on KeePassXC-Browser by the KeePassXC Team",
  "license": "GPL-3.0",
  "private": true,
  "bugs": {
    "url": "https://github.com/fwdai/rowel/issues"
  },
  "homepage": "https://github.com/fwdai/rowel/blob/main/docs/browser-extension.md"
}
