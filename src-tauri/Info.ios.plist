<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shown in the Face ID consent sheet the first time the vault is unlocked
	     biometrically. Required: LAContext raises without it. -->
	<key>NSFaceIDUsageDescription</key>
	<string>Rowel uses Face ID to unlock your vault.</string>
	<!-- The activity the system launches the app with when another password
	     manager exports to it (CredentialExchange.swift). The string is the
	     SDK's ASCredentialExchangeActivity; Apple's documentation also
	     spells it with a "Type" suffix, which nothing sends. -->
	<key>NSUserActivityTypes</key>
	<array>
		<string>ASCredentialExchangeActivity</string>
	</array>
</dict>
</plist>
