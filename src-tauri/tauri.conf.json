{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowel",
  "version": "1.0.0",
  "identifier": "app.rowel.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rowel",
        "create": false,
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "files": {
        "embedded.provisionprofile": "./embedded.provisionprofile"
      }
    },
    "iOS": {
      "developmentTeam": "UFBL3F444A",
      "minimumSystemVersion": "16.0"
    },
    "fileAssociations": [
      {
        "ext": ["rowel"],
        "name": "Rowel Backup",
        "description": "Rowel encrypted vault backup",
        "mimeType": "application/vnd.rowel"
      },
      {
        "ext": ["swftx"],
        "name": "Rowel Legacy Vault",
        "description": "Rowel legacy encrypted vault (import only)",
        "mimeType": "application/vnd.swftx"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fwdai/rowel/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NzQ0QTJDOTI4Nzk2MzAKUldRd2xvZVNMRXAwMXE4ZUFSS2ptZmJObkNGb25HNitZTjlUM0JTempyN3dOdVVpMllIVE1lWWIK"
    }
  }
}
