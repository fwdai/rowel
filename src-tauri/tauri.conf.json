{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rowel",
  "version": "1.0.4",
  "identifier": "app.rowel.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Rowel",
        "create": false,
        "width": 1200,
        "height": 780,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; connect-src 'self'; object-src 'none'; frame-src blob:; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "license": "GPL-3.0-only",
    "homepage": "https://rowel.app",
    "longDescription": "Keep every password, passkey, card, ID, SSH key, .env file and more in one\nencrypted vault on your own devices. No account, no server, no subscription.\nSync is optional and goes through your own cloud, which only ever stores\nciphertext.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "files": {
        "embedded.provisionprofile": "./embedded.provisionprofile"
      }
    },
    "linux": {
      "deb": {
        "files": {
          "/usr/share/doc/rowel/copyright": "./linux/copyright"
        }
      }
    },
    "iOS": {
      "developmentTeam": "UFBL3F444A",
      "minimumSystemVersion": "16.0"
    },
    "fileAssociations": [
      {
        "ext": ["rowel"],
        "name": "Rowel Backup",
        "description": "Rowel encrypted vault backup",
        "mimeType": "application/vnd.rowel"
      },
      {
        "ext": ["swftx"],
        "name": "Rowel Legacy Vault",
        "description": "Rowel legacy encrypted vault (import only)",
        "mimeType": "application/vnd.swftx"
      }
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/fwdai/rowel/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ2NzQ0QTJDOTI4Nzk2MzAKUldRd2xvZVNMRXAwMXE4ZUFSS2ptZmJObkNGb25HNitZTjlUM0JTempyN3dOdVVpMllIVE1lWWIK"
    }
  }
}
