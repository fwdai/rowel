.DS_Store
.env
.env.local

# JS / Vite
node_modules
dist
dist-ssr
*.local

# Browser extension (extension/.gitignore covers zips and node_modules)
extension/build/
extension/rowel/tests/
extension/test-results/
extension/playwright-report/
# Upstream keeps its per-browser manifests in extension/dist/; not build output.
!extension/dist/

# Rust / Tauri
src-tauri/target
src-tauri/gen/schemas
# The command line tool as the release build stages it for the bundler
# (`rowel-cli-<target triple>`, see release.yml); a dev build never needs it.
src-tauri/binaries/

# Updater signing keys — never commit
*.key
*.key.pub

# Claude Code local state & agent worktrees
.claude/

# Local dev vault used when running the app from the workspace (see ROWEL_DB_DIR)
.dev-vault/

# Python bytecode (scripts/emblems)
__pycache__/
