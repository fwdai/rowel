{
  "name": "rowel",
  "version": "1.1.0",
  "description": "Local-first secret manager for passwords, passkeys, cards, IDs, SSH keys, API keys and .env files",
  "type": "module",
  "repository": "https://github.com/fwdai/rowel.git",
  "author": {
    "name": "Alex Chaplinsky",
    "email": "alchaplinsky@gmail.com"
  },
  "license": "GPL-3.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wdio run tests/e2e/wdio.conf.ts",
    "test:e2e:build": "bun run build && cargo build --manifest-path src-tauri/Cargo.toml && bun run test:e2e",
    "logo": "bun run scripts/logo.tsx",
    "icons": "bun run scripts/icons.mjs",
    "extension:install": "cd extension && npm ci",
    "extension:build": "cd extension && npm run build && npm run build:safari && cd .. && bun scripts/check-extension-build.mjs",
    "extension:lint": "bun scripts/extension-sync.mjs --check && bun scripts/extension-strings.mjs --check && bun scripts/extension-theme.mjs --check && cd extension && npm run lint",
    "extension:test": "cd extension && npm run test:safari && npm run tests",
    "extension:icons": "bun scripts/extension-icons.mjs",
    "extension:strings": "bun scripts/extension-strings.mjs",
    "extension:sync": "bun scripts/extension-sync.mjs && bun run extension:strings && bun run extension:icons && bun run extension:theme",
    "extension:theme": "bun scripts/extension-theme.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:dev:fresh": "ROWEL_DB_DIR=\"${ROWEL_DB_DIR:-${TMPDIR:-/tmp}/rowel-fresh-$$}\" tauri dev",
    "tauri:build": "tauri build",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "release:ios": "bash scripts/release-ios.sh",
    "release:local": "bash scripts/release-local.sh"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "fuse.js": "^7.5.0",
    "i18next": "^26.5.4",
    "i18next-resources-to-backend": "^1.2.3",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/mocha": "^10.0.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "fit-curve": "^0.2.0",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.5",
    "webdriverio": "^9.32.0"
  }
}
